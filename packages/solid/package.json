{
  "name": "@voxel-tool/solid",
  "version": "0.4.2",
  "description": "SolidJS 3D viewer component for MagicaVoxel .vox models (built on @voxel-tool/viewer + Three.js)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "build": "vite build",
    "preview": "vite preview --config example/vite.config.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "dependencies": {
    "@voxel-tool/core": "^0.3.0",
    "@voxel-tool/viewer": "^0.4.0"
  },
  "devDependencies": {
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "solid-js": "^1.9.3",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "vox",
    "magicavoxel",
    "voxel",
    "solid",
    "solidjs",
    "three",
    "renderer",
    "voxel-tool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maicarons/voxel-tool.git",
    "directory": "packages/solid"
  },
  "homepage": "https://github.com/Maicarons/voxel-tool#readme",
  "bugs": {
    "url": "https://github.com/Maicarons/voxel-tool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
