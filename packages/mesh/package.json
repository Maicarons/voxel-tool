{
  "name": "@voxel-tool/mesh",
  "version": "0.1.0",
  "description": "Shared voxel mesh construction (face culling + vertex colors + greedy meshing + instance transform), used by @voxel-tool/viewer and @voxel-tool/exporter",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  },
  "keywords": [
    "vox",
    "magicavoxel",
    "voxel",
    "three",
    "mesh",
    "voxel-tool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maicarons/voxel-tool.git",
    "directory": "packages/mesh"
  },
  "homepage": "https://github.com/Maicarons/voxel-tool#readme",
  "bugs": {
    "url": "https://github.com/Maicarons/voxel-tool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
