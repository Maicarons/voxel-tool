{
  "name": "@voxel-tool/qwik",
  "version": "0.3.0",
  "description": "Qwik 3D viewer component for MagicaVoxel .vox models (built on @voxel-tool/viewer + Three.js)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "build": "vite build",
    "preview": "vite preview --config example/vite.config.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.5.0"
  },
  "dependencies": {
    "@voxel-tool/core": "^0.2.0",
    "@voxel-tool/viewer": "^0.2.0"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "keywords": [
    "vox",
    "magicavoxel",
    "voxel",
    "qwik",
    "three",
    "renderer",
    "voxel-tool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maicarons/voxel-tool.git",
    "directory": "packages/qwik"
  },
  "homepage": "https://github.com/Maicarons/voxel-tool#readme",
  "bugs": {
    "url": "https://github.com/Maicarons/voxel-tool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
