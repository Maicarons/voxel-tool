{
  "name": "@voxel-tool/preact",
  "version": "0.1.1",
  "description": "Preact 3D viewer component for MagicaVoxel .vox models (built on @voxel-tool/viewer + Three.js)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite --config example/vite.config.js",
    "build": "vite build",
    "preview": "vite preview --config example/vite.config.js",
    "test": "node test.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@voxel-tool/core": "^0.1.1",
    "@voxel-tool/viewer": "^0.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "preact": "^10.25.4",
    "vite": "^5.4.11"
  },
  "keywords": ["vox", "magicavoxel", "voxel", "preact", "three", "renderer", "voxel-tool"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maicarons/voxel-tool.git",
    "directory": "packages/preact"
  },
  "homepage": "https://github.com/Maicarons/voxel-tool#readme",
  "bugs": { "url": "https://github.com/Maicarons/voxel-tool/issues" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" }
