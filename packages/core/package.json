{
  "name": "@voxel-tool/core",
  "version": "0.3.0",
  "description": "Dependency-free MagicaVoxel .vox read/write, palette, and VoxelGrid core library (Node + browser)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=esm --platform=browser --outfile=dist/index.js --legal-comments=none",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vox",
    "magicavoxel",
    "voxel",
    "format",
    "voxel-tool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maicarons/voxel-tool.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Maicarons/voxel-tool#readme",
  "bugs": {
    "url": "https://github.com/Maicarons/voxel-tool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
