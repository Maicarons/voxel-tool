{
  "name": "@voxel-tool/viewer",
  "version": "0.4.1",
  "description": "Framework-agnostic Three.js voxel viewer core (buildVoxelGeometry + createVoxelViewer), shared by the React/Vue/Solid/Preact/Svelte/Qwik components",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@voxel-tool/core": "^0.3.0",
    "@voxel-tool/mesh": "^0.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "keywords": [
    "vox",
    "magicavoxel",
    "voxel",
    "three",
    "viewer",
    "voxel-tool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maicarons/voxel-tool.git",
    "directory": "packages/viewer"
  },
  "homepage": "https://github.com/Maicarons/voxel-tool#readme",
  "bugs": {
    "url": "https://github.com/Maicarons/voxel-tool/issues"
  },
